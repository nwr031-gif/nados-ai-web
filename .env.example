# =====================================================
# Nados AI — مثال متغيرات البيئة (انسخه إلى .env)
# لا تضع أسراراً حقيقية هنا — هذا الملف يُتتبَّع في git
# =====================================================

# --- الأساسيات ---
PORT=4000
# 127.0.0.1 = محلي فقط (آمن افتراضياً). استخدم 0.0.0.0 إن أردت الوصول من الشبكة/النفق.
HOST=127.0.0.1
NODE_ENV=production

# --- Cloudflare Workers AI (مطلوب) ---
# التوكن: من dash.cloudflare.com → My Profile → API Tokens → Create Token (Workers AI Read)
CF_API_TOKEN=
CF_ACCOUNT_ID=
# عدة حسابات = حصة يومية أكبر (لكل حساب حصة منفصلة)
CF_ACCOUNTS=
CF_DAILY_NEURONS=10000
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- أمان الواجهة المحلية ---
# مفتاح الوصول لواجهات API. اتركه فارغاً ليُولَّد تلقائياً عند الإقلاع (يُطبع في السجل).
# مُطلوب فقط لأدوات سطر الأوامر (diagnose / benchmark)؛ المتصفح يحصل على جلسة عبر كوكي.
NADOS_API_KEY=
# تعطيل المصادقة (خطير — لا تفعله إلا على جهاز معزول)
NADOS_AUTH=1

# --- مزوّدات بديلة (اختيارية) — تُفعَّل تلقائياً عند إضافة المفتاح ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# POLLINATIONS_MODEL=gpt-oss-20b

# --- سلوك ---
# مهلة المزوّد بالمللي ثانية
NADOS_PROVIDER_TIMEOUT=90000
# حد الطلبات لكل دقيقة لكل عميل (token bucket)
NADOS_RATE_LIMIT=30
# منفذ/عنوان المشغّل (24/7)
# NADOS_DEBUG_RAW=0
